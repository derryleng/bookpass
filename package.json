{
  "name": "bookpass",
  "version": "0.0.1",
  "private": true,
  "description": "Encrypted bookmark manager that stores bookmarks in a KeePass KDBX 4.1 file",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "test": "vitest run",
    "helper:build": "cd helper && go build -o bin/bookpass-helper.exe .",
    "helper:test": "cd helper && go test ./...",
    "helper:register": "node scripts/register-helper.ts",
    "helper:unregister": "node scripts/register-helper.ts --remove",
    "e2e": "node tests/e2e/core.ts",
    "e2e:more": "node tests/e2e/features.ts",
    "e2e:a11y": "node tests/e2e/a11y.ts",
    "e2e:security": "node tests/e2e/security.ts",
    "e2e:perf": "node tests/e2e/perf.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run helper:test",
    "zip:store": "node scripts/zip-store.ts",
    "e2e:all": "npm run e2e && npm run e2e:more && npm run e2e:a11y && npm run e2e:security",
    "e2e:firefox": "node tests/e2e/firefox.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
